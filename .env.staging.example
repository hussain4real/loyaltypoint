# Inject populated secrets from the environment-specific managed store; never copy production credentials.
APP_ENV=staging
APP_DEBUG=false
APP_KEY=
APP_URL=https://replace-staging-host.invalid
DB_CONNECTION=mysql
DB_HOST=replace-staging-private-database.invalid
DB_DATABASE=pull2spend_staging
DB_USERNAME=pull2spend_staging
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_COOKIE=pull2spend_staging_session
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=database
CACHE_PREFIX=pull2spend_staging_cache
QUEUE_CONNECTION=database
DB_QUEUE=pull2spend_staging_foundation
DB_QUEUE_RETRY_AFTER=90
FILESYSTEM_DISK=pull2spend_private
MAIL_MAILER=log
LOG_CHANNEL=stderr
LOG_LEVEL=notice
PULL2SPEND_NAMESPACE=staging
PULL2SPEND_SECRET_STORE_REFERENCE=
PULL2SPEND_BACKUP_EVIDENCE_REFERENCE=
PULL2SPEND_ALERT_OWNER_REFERENCE=
PULL2SPEND_BACKOFFICE_ENABLED=false
PULL2SPEND_CALLBACKS_ENABLED=false
PULL2SPEND_SIMULATORS_ENABLED=false

# Phase 2 remains disabled until identity providers and approved policies are supplied.
PULL2SPEND_CONSUMER_IDENTITY_ENABLED=false
PULL2SPEND_TERMS_VERSION=
PULL2SPEND_PRIVACY_NOTICE_VERSION=
PULL2SPEND_VERIFICATION_MODE=unavailable
PULL2SPEND_VERIFICATION_CALLBACK_KEY=
PULL2SPEND_IDENTITY_POLICY_REFERENCE=
PULL2SPEND_IDENTITY_POLICY_APPROVED=false
